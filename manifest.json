{
  "manifest_version": 3,
  "name": "HAHU kereső",
  "version": "0.5.1",
  "description": "Természetes nyelvű autókeresés a Használtautó.hu saját szűrőivel.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://demo.lorinczbarnabas.hu/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hasznaltauto.hu/",
        "https://www.hasznaltauto.hu/kereso*"
      ],
      "js": [
        "quick-search-ui.js",
        "native-adapter.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hasznaltauto.hu/bovitettkereso/*"
      ],
      "all_frames": true,
      "js": [
        "form-state.js",
        "native-adapter.js",
        "advanced.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hasznaltauto.hu/*",
        "https://hasznaltauto.hu/*"
      ],
      "js": [
        "result-note.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_popup": "popup.html",
    "default_title": "HAHU kereső"
  },
  "key": ""
}
